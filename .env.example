# Telegram Bot
TELEGRAM_BOT_TOKEN=your_token_from_botfather

# Bot Admins (comma-separated Telegram IDs who will receive answers to tasks)
# Get your Telegram ID from @userinfobot
BOT_ADMINS=123456789,987654321

# Bot Welcome Message (optional, defaults to a standard message)
BOT_WELCOME_MESSAGE=Добро пожаловать в систему обучения! Выберите тему из меню ниже.

# Admin Panel
ADMIN_PASSWORD=your_admin_password

# Database
# For Vercel: DATABASE_URL will be set automatically when you connect Postgres storage
# For local development with Postgres: 
#   1. Create DB: psql -U postgres -c "CREATE DATABASE truewish;"
#   2. Create user: psql -U postgres -c "CREATE USER truewish WITH PASSWORD 'truewish123';"
#   3. Set: DATABASE_URL=postgresql://truewish:truewish123@localhost:5432/truewish
#   4. Init tables: node scripts/init-local-db.js
# For local development with SQLite: use db-sqlite.js and models-sqlite.js backups
DATABASE_URL=

# Web App URL (for bot's website button)
# For local: http://localhost:3011
# For production: https://your-domain.vercel.app
WEB_APP_URL=http://localhost:3011

# Next.js server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3011
